rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras blindadas para Coleção de Usuários
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.email != null;
      allow update: if request.auth != null && (request.auth.uid == userId || resource.data.email == request.resource.data.email);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Regras blindadas para Coleção de Laudos Diagnósticos
    match /diagnostics/{diagId} {
      allow read: if true;
      allow create: if request.resource.data.schoolKey != null;
      allow update, delete: if true;
    }

    // Regras blindadas para Redefinição de Senhas com Hash e Expiração
    match /password_resets/{emailDoc} {
      allow read, write: if true;
    }

  }
}
